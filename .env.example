# OpenRouter API key (get one at https://openrouter.ai/keys)
# Leave empty in public mode — users bring their own key.
OPENROUTER_API_KEY=

# Optional: choose a model (default: anthropic/claude-sonnet-4)
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Set to "true" for public hosting (disables live preview, enforces BYO key)
PUBLIC_MODE=false

# Upload limits (optional, these are the defaults)
# MAX_FILE_SIZE_MB=10
# MAX_SHEETS=20
# MAX_ROWS_PER_SHEET=50000
# MAX_COLUMNS_PER_SHEET=100
# RATE_LIMIT_UPLOADS=10
# RATE_LIMIT_WINDOW_SECONDS=3600
